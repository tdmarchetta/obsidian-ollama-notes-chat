{
  "name": "obsidian-ollama-notes-chat",
  "version": "1.7.20",
  "description": "Chat with your notes in a right sidebar using a remote Ollama server.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "ollama",
    "ai",
    "chat"
  ],
  "author": "Taylor Marchetta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdmarchetta/obsidian-ollama-notes-chat.git"
  },
  "bugs": {
    "url": "https://github.com/tdmarchetta/obsidian-ollama-notes-chat/issues"
  },
  "homepage": "https://github.com/tdmarchetta/obsidian-ollama-notes-chat#readme",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    }
  }
}
